# Native modules must resolve from a single copy for Metro and pod/gradle linking
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*prettier*
# RN libraries ship peer deps expecting flat installs; keep resolution lenient
strict-peer-dependencies=false
auto-install-peers=true
# Turbo remote cache auth (disabled until CI configures it)
