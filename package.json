{
  "name": "society-expense-splitter",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for the Society Expense Splitter app (Expo mobile + NestJS API + shared packages)",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint:arch": "depcruise apps packages --config .dependency-cruiser.js",
    "dev:infra": "docker compose -f infra/docker/docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f infra/docker/docker-compose.dev.yml down",
    "openapi": "pnpm --filter @ses/api openapi",
    "contract:drift": "pnpm openapi && git diff --exit-code -- docs/api/OPENAPI.yaml",
    "contract:breaking": "node scripts/codegen/openapi-breaking-diff.mjs",
    "db:migrate": "pnpm --filter @ses/api db:migrate",
    "db:reset": "pnpm --filter @ses/api db:reset",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md,yml,yaml}\""
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@eslint/js": "^9.39.2",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "yaml": "^2.8.1",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8"
  }
}
