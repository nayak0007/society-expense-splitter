# Society Expense Splitter — API environment
#
# Copy to `.env` and fill in. The process REFUSES TO START on a missing or
# malformed variable (SAD §19.2): a configuration error must fail at deploy time,
# not at 2am on the first code path that reads `undefined`.
#
# NEVER commit `.env`. Local development reads this file; staging and production
# are injected at runtime from a secrets manager (SAD §13.4).

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ── Data tier ────────────────────────────────────────────────────────────────
# DATABASE_URL is the RUNTIME connection. Use the `authenticator` role: it logs
# in, then each transaction switches to `authenticated` so Row Level Security
# applies. Its credentials are intentionally the weaker ones.
DATABASE_URL=postgresql://authenticator:authenticator@localhost:5432/ses
#
# MIGRATION_DATABASE_URL is the OWNER connection, used only by DDL (drizzle-kit
# and `pnpm db:migrate`). Keeping it separate is what stops the API from holding
# a role that can bypass RLS. Production and staging refuse to start if both URLs
# name the same role.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ses

REDIS_URL=redis://localhost:6379

# SAD §14.4: 10s for API connections. The worker process must raise this (120s)
# once a processor lands, because a maintenance cycle publish for 2,000 flats is
# legitimately slow.
DB_STATEMENT_TIMEOUT_MS=10000
DB_POOL_MAX=10

# ── Supabase (identity, storage) ─────────────────────────────────────────────
# Supabase Auth is the identity provider of record: it issues the RS256 access
# tokens this API verifies, and owns `auth.users`. See `supabase/README.md`.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# ADMIN OPERATIONS ONLY — this key bypasses RLS entirely. It must never serve a
# user-facing query; those go through DATABASE_URL so the policies still apply.
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-32-character-minimum-value

STORAGE_PROVIDER=supabase
STORAGE_BUCKET=ses-attachments

# ── Observability ────────────────────────────────────────────────────────────
# SENTRY_DSN is REQUIRED when NODE_ENV is production or staging.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# fatal | error | warn | info | debug | trace | silent
# Defaults to debug in development, info elsewhere, silent under test.
LOG_LEVEL=

# ── Vendors: optional until the adapter that consumes them lands ─────────────
# These become REQUIRED in the same change that ships their adapter. Requiring
# them today would make the process refuse to boot for no reason, and a
# meaningless "missing variable" error trains people to paste dummy values.
#
# Production and staging additionally reject a key starting with `rzp_test_`.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MSG91_AUTH_KEY=
RESEND_API_KEY=
EXPO_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# hex, 32 bytes (64 characters). Required in production and staging.
ENCRYPTION_KEY=
