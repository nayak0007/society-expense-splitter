# Resident 360 — API environment
#
# Copy to `.env` and fill in. The process REFUSES TO START on a missing or
# malformed variable (SAD §19.2): a configuration error must fail at deploy time,
# not at 2am on the first code path that reads `undefined`.
#
# NEVER commit `.env`. Local development reads this file; staging and production
# are injected at runtime from a secrets manager (SAD §13.4).

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ── Data tier ────────────────────────────────────────────────────────────────
# DATABASE_URL is the RUNTIME connection. Use the `authenticator` role: it logs
# in, then each transaction switches to `authenticated` so Row Level Security
# applies. Its credentials are intentionally the weaker ones.
DATABASE_URL=postgresql://authenticator:authenticator@localhost:5432/ses
#
# MIGRATION_DATABASE_URL is the OWNER connection, used only by DDL — the
# migration runner (`pnpm db:migrate`, the CI test-db job, the deploy-time
# migrate step). Keeping it separate is what stops the API from holding a role
# that can bypass RLS. Production and staging refuse to start if both URLs name
# the same role.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ses
#
# MIGRATIONS_DIR is optional and normally unset: the runner resolves
# supabase/migrations from the working directory upward. The container image
# sets it to /app/migrations (see infra/docker/api.Dockerfile).
# MIGRATIONS_DIR=

REDIS_URL=redis://localhost:6379

# SAD §14.4: 10s for API connections. The worker process must raise this (120s)
# once a processor lands, because a maintenance cycle publish for 2,000 flats is
# legitimately slow.
DB_STATEMENT_TIMEOUT_MS=10000
DB_POOL_MAX=10

# ── Supabase (identity) ───────────────────────────────────────────────────────
# Supabase Auth is the identity provider of record: it issues the RS256 access
# tokens this API verifies, and owns `auth.users`. See `supabase/README.md`.
# The database is Supabase PostgreSQL as well; object bytes are NOT — see the
# storage block below.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# ADMIN OPERATIONS ONLY — this key bypasses RLS entirely. It must never serve a
# user-facing query; those go through DATABASE_URL so the policies still apply.
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-32-character-minimum-value

# ── Object storage (SAD §10.2, §14.2; ADR-0012) ──────────────────────────────
#
# Bytes NEVER pass through the API (SAD §10.1). The API mints a presigned PUT
# whose signature pins the exact byte count the client declared, the device
# uploads straight to the store, and completion verifies what landed before the
# attachment is marked complete. ONE S3-compatible adapter serves every provider
# (ADR-0012 D1) — these variables select the endpoint, not a code path.
#
# Deployment intent (2026-10-07): Supabase provides PostgreSQL and Auth; the API,
# Redis and the object store run on a VPS. So the deployed store is whichever
# S3-compatible endpoint the deployment actually runs, and Supabase Storage is a
# SUPPORTED, verified-compatible option rather than a required one.
#
#   minio     local development (default). `pnpm dev:infra` starts it. REFUSED
#             outside development, because a deployed process pointed at a
#             developer's laptop would "work" until the first upload went nowhere.
#   s3        any operator-hosted / third-party S3-compatible endpoint: the VPS
#             object store, AWS S3, or another compatible service. Naming this
#             value is the provider-neutral choice; pair it with the endpoint,
#             region, credentials and bucket below.
#   supabase  Supabase Storage, addressed through its own S3 endpoint (derived
#             from SUPABASE_URL when STORAGE_ENDPOINT is unset).
#   r2        a Cloudflare R2 bucket.
STORAGE_PROVIDER=minio
STORAGE_BUCKET=ses-attachments
#
# The S3 API endpoint — the value that actually decides which store receives the
# bytes. Optional only where a label has a default (locally http://localhost:9000;
# for `supabase`, the project's own storage hostname). REQUIRED in staging and
# production for every label, `s3` included.
# STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
#
# The S3 access key pair. SERVER-SIDE ONLY — never returned to a client, never
# logged, never placed in the OpenAPI document. The client receives a presigned
# URL, which is a derived credential bound to one object, one method, one byte
# count and one expiry. REQUIRED in staging and production; locally the compose
# service's own throwaway credentials are used.
# STORAGE_ACCESS_KEY_ID=ses_minio
# STORAGE_SECRET_ACCESS_KEY=ses_minio_local
#
# Path-style addressing (`.../bucket/key`). On by default: MinIO on a bare
# hostname cannot resolve a bucket subdomain, and Supabase Storage's S3 endpoint
# served path-style in every probe ADR-0012 records. A virtual-hosted endpoint
# (most hosted providers) sets this false.
STORAGE_FORCE_PATH_STYLE=true
#
# Create the bucket at boot if it is missing. ON ONLY IN LOCAL DEVELOPMENT AND
# THE INTEGRATION SUITE, off by default and never in a deployed environment.
# It replaces a compose `createbuckets` service that ran `mc` from an image that
# no longer exists (see infra/docker/docker-compose.dev.yml); doing it from the
# API's own SDK is the smallest maintainable replacement.
STORAGE_AUTO_CREATE_BUCKET=false
#
# Presign lifetime. 900 seconds is SAD §10.1's "15 min" and the same window an
# unfinished upload reserves quota for.
STORAGE_PRESIGN_TTL_SECONDS=900
#
# NOTE, and it is a provider-specific layer rather than a portable one: Supabase
# Storage enforces a per-object `file_size_limit` (set it to 10485760 in the
# project's storage settings) and answers 413 EntityTooLarge above it. Neither the
# pinned local MinIO nor a plain S3-compatible endpoint has an equivalent —
# measured, ADR-0012 D1 probe 28 — so the *portable* guarantees are the exact-size
# signature, the API's per-type cap, and mandatory completion verification. Set the
# bucket limit too wherever the configured store offers one; rely on it nowhere.

# ── Observability ────────────────────────────────────────────────────────────
# SENTRY_DSN is REQUIRED when NODE_ENV is production or staging.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# fatal | error | warn | info | debug | trace | silent
# Defaults to debug in development, info elsewhere, silent under test.
LOG_LEVEL=

# ── Vendors: optional until the adapter that consumes them lands ─────────────
# These become REQUIRED in the same change that ships their adapter. Requiring
# them today would make the process refuse to boot for no reason, and a
# meaningless "missing variable" error trains people to paste dummy values.
#
# Production and staging additionally reject a key starting with `rzp_test_`.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MSG91_AUTH_KEY=
RESEND_API_KEY=
EXPO_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# hex, 32 bytes (64 characters). Required in production and staging.
ENCRYPTION_KEY=
