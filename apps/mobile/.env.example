# Society Expense Splitter — mobile environment
#
# ONLY these variables may be EXPO_PUBLIC_* (they ship in the client
# bundle and are readable by anyone with the APK — SAD §19.2).
# Every other secret goes through EAS Secrets, never into this file.

# Base URL of the SES API
EXPO_PUBLIC_API_URL=http://localhost:3000/v1

# Supabase project (public values — RLS is the security boundary)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Razorpay KEY ID (public identifier only — never the key secret)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Sentry DSN (public, client-side)
EXPO_PUBLIC_SENTRY_DSN=

# PostHog public project key
EXPO_PUBLIC_POSTHOG_KEY=
